# ============================================================================
# Frontend Environment Configuration (Next.js)
# ============================================================================

# Internal FastAPI Base URL (Server Actions use this server-side)
FASTAPI_BASE_URL=http://localhost:8000

# Public API URL (Exposed to client browser if needed)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only Hugging Face & Backend tokens (Never exposed to browser)
HF_TOKEN=hf_**********************************
